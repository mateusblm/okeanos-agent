# Paste only the entry for the AGENT set in main.mts. The user fills this in;
# the agent running the afk skill never reads or writes it.

# Claude Code (AGENT = "claude"): run `claude setup-token` on your host and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=
# Or an Anthropic API key instead:
# ANTHROPIC_API_KEY=

# Codex (AGENT = "codex"): an OpenAI API key, read by the Codex CLI as OPENAI_API_KEY.
# OPENAI_API_KEY=

# GitHub Copilot CLI (AGENT = "copilot"): a GitHub token with the "Copilot Requests"
# permission (fine-grained PAT, or a token from `gh auth token`).
# COPILOT_GITHUB_TOKEN takes precedence over GH_TOKEN and GITHUB_TOKEN.
# GITHUB_TOKEN=

# Cursor (AGENT = "cursor"): a Cursor API key.
# CURSOR_API_KEY=
